# Staging stack template (ADR-0015). Names only, never values.
# Create the real file with ./deploy/staging/generate-secrets.sh: it copies
# this file to .env.staging (git-ignored) and fills the generated secrets.

# Postgres (db). The CMS gets these as DATABASE_NAME/USERNAME/PASSWORD.
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=

# Strapi secrets (cms). generate-secrets.sh fills them; APP_KEYS is four comma-separated keys.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Frontend build args (fe image). Inlined at build: change them, then rebuild fe.
# NEXT_PUBLIC_SITE_URL must match FE_PORT. Inside the stack the CMS is http://cms:1337.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://cms:1337
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Frontend runtime (fe). The two secrets are generated; the webhook in the CMS
# admin uses REVALIDATE_SECRET as "Bearer <value>".
REVALIDATE_SECRET=
PREVIEW_SECRET=
# Read-only tokens, created in the CMS admin after the first start (runbook step 4).
CMS_API_TOKEN=
CMS_PREVIEW_TOKEN=
# Keep empty until the CMS developer's CMS-nn changes are on this CMS.
CMS_CAPABILITIES=
# Staging basic auth (REQ-INFRA-006). generate-secrets.sh sets the user to ffid and generates the password.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=
# 1 shows /harness on staging.
FEATURE_HARNESS=

# One-off seed service. A full-access token for seeding only; blank it after seeding.
CMS_SEED_TOKEN=
# default or demo (ADR-0014). Staging uses demo.
SEED_PROFILE=demo

# Host ports. 127.0.0.1 keeps the stack off the local network.
FE_BIND=127.0.0.1
FE_PORT=3000
CMS_BIND=127.0.0.1
CMS_PORT=1337

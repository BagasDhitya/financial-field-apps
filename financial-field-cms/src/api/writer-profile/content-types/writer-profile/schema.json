{
  "kind": "collectionType",
  "collectionName": "writer_profiles",
  "info": {
    "singularName": "writer-profile",
    "pluralName": "writer-profiles",
    "displayName": "Writer Profile"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "full_name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "full_name"
    },
    "role_title": {
      "type": "string"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "bio": {
      "type": "text"
    },
    "admin_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "writer_profile"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "author"
    },
    "article": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "reviewer"
    }
  }
}

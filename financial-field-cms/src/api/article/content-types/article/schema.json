{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "lead_text": {
      "type": "text"
    },
    "content": {
      "type": "blocks"
    },
    "featured_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "article_type": {
      "type": "enumeration",
      "enum": [
        "standard",
        "pr_article",
        "interview",
        "column"
      ]
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "articles"
    },
    "primary_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "category"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::writer-profile.writer-profile",
      "inversedBy": "articles"
    },
    "reviewer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::writer-profile.writer-profile",
      "inversedBy": "article"
    },
    "stocks_mentioned": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::stock-ticker.stock-ticker",
      "inversedBy": "articles"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "articles"
    }
  }
}

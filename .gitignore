# Strapi ignored files
financial-field-cms/node_modules/
financial-field-cms/.tmp/
financial-field-cms/.cache/
financial-field-cms/dist/
financial-field-cms/.env
financial-field-cms/public/uploads/
# CMS env variants (only the example is committed)
financial-field-cms/.env*
!financial-field-cms/.env.example

# Database files and copies anywhere (the local SQLite lives in .tmp/)
*.db
*.db.*

# OS files
.DS_Store

# No root package: a root lockfile is always a mistake
/package-lock.json

# Staging stack secrets (only the example is committed; ADR-0015)
deploy/**/.env*
!deploy/**/.env*.example

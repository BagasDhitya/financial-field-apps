{
  "name": "financial-field-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock-cms": "node tests/mock-cms/server.mjs",
    "seed:cms": "node --env-file-if-exists=.env.local scripts/seed-cms/seed.mjs",
    "seed:cms:reset": "node --env-file-if-exists=.env.local scripts/seed-cms/seed.mjs --reset",
    "seed:cms:verify": "node --env-file-if-exists=.env.local scripts/seed-cms/verify.mjs",
    "test:e2e": "playwright test",
    "seo:check": "node scripts/seo-check.mjs",
    "lhci": "lhci autorun",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "16.4.2",
    "qs": "^6.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/qs": "^6.15.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.25.0"
}

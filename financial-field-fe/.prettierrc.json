{
	"printWidth": 100,
	"tabWidth": 4,
	"useTabs": true,
	"semi": true,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": ["*.md", "*.yml", "*.yaml", "package.json"],
			"options": { "useTabs": false, "tabWidth": 2 }
		}
	]
}

# Public site origin. Used for canonical URLs, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# local | staging | production. Anything but production is noindex.
SITE_ENV=local

# GA4 measurement ID. Empty disables analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Feature flags for later phases. 1 = on. Default off.
FEATURE_COMPARISON=
FEATURE_ADS=
FEATURE_NEWSLETTER=
FEATURE_HARNESS=
# FAQPage JSON-LD (ADR-0006). Default on; set 0 to disable.
FEATURE_FAQ_SCHEMA=

# HTTP basic auth for the staging frontend, enforced only when SITE_ENV=staging and
# both are set (REQ-INFRA-006). Leave empty locally and in production.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# CMS. Leave CMS_URL empty: the site reads the local API, which serves src/data in the
# CMS's own REST shape (PRP-0002.p1 §S4.8). Set it only to read a real Strapi, e.g.
# https://financial-field-cms.vercel.app (no trailing slash).
CMS_URL=
# Read-only Strapi API token, only with CMS_URL. Server-only; never NEXT_PUBLIC_.
CMS_API_TOKEN=
# Only with CMS_URL: the CMS-nn field groups that CMS already has (strictParams rejects
# unknown keys). Comma-separated, or all. The local API has every field.
CMS_CAPABILITIES=

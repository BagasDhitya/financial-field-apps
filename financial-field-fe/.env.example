# Public site origin. Used for canonical URLs, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strapi origin used for server-side data fetching.
CMS_URL=http://localhost:1337

# Strapi origin embedded in media URLs. Must be browser-reachable.
NEXT_PUBLIC_CMS_URL=http://localhost:1337

# Read-only Strapi API token. Server-only — never prefix with NEXT_PUBLIC_.
CMS_API_TOKEN=

# Draft-read Strapi API token, used only by preview. Server-only.
CMS_PREVIEW_TOKEN=

# Shared secret for the Strapi revalidation webhook.
REVALIDATE_SECRET=

# Shared secret for the draft preview entry point.
PREVIEW_SECRET=

# Set to 1 only in CI, where no Strapi is running. Local and production leave it unset.
SKIP_CMS_FETCH=

# local | staging | production. Anything but production is noindex.
SITE_ENV=local

# GA4 measurement ID. Empty disables analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# CMS fields the frontend may request (strictParams rejects unknown keys).
# Comma-separated. See runbooks/env-vars.md in the pack for the list.
CMS_CAPABILITIES=

# Feature flags for later phases. 1 = on. Default off.
FEATURE_COMPARISON=
FEATURE_ADS=
FEATURE_NEWSLETTER=
FEATURE_HARNESS=
# FAQPage JSON-LD (ADR-0006). Default on; set 0 to disable.
FEATURE_FAQ_SCHEMA=

# Demo content seed (PRP-0002.p1 Part B, RUN-seed-content). Local/staging only — the
# seed refuses SITE_ENV=production. Full-access token; never commit a value.
CMS_SEED_TOKEN=
# Hosts the seed may write to. Empty = localhost,127.0.0.1.
SEED_ALLOWED_HOSTS=
# default (unset) or demo. demo drops the visible demo markers; use it on staging (ADR-0014).
SEED_PROFILE=

# HTTP basic auth for the staging frontend, enforced only when SITE_ENV=staging and
# both are set (REQ-INFRA-006). Leave empty locally and in production.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=
